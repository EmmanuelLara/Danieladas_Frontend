{
  "name": "com.neveria.app",
  "displayName": "NeveriaApp",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application that responds to the deviceready event.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Apache Cordova Team",
  "license": "Apache-2.0",
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-advanced-http": {
        "ANDROIDBLACKLISTSECURESOCKETPROTOCOLS": "SSLv3,TLSv1"
      },
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-camera": {
        "CAMERA_USAGE_DESCRIPTION": "Esta app necesita acceso a la cámara para escanear códigos QR de tickets",
        "PHOTOLIBRARY_USAGE_DESCRIPTION": "Esta app necesita acceso a la galería para guardar tickets"
      },
      "cordova-plugin-file": {},
      "cordova-plugin-file-opener2": {},
      "cordova-plugin-x-socialsharing": {}
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "framework7": "^8.3.4"
  },
  "devDependencies": {
    "@capacitor-community/barcode-scanner": "^4.0.1",
    "cordova-android": "^14.0.1",
    "cordova-plugin-advanced-http": "^3.3.1",
    "cordova-plugin-android-permissions": "^1.1.2",
    "cordova-plugin-camera": "^7.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-file-opener2": "^4.0.0",
    "cordova-plugin-x-socialsharing": "^6.0.4",
    "es6-promise-plugin": "^4.2.2"
  }
}